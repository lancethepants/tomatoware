config BR2_PACKAGE_CCACHE_TARGET
	bool "ccache"
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_8 # C++20, blake3
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_BLAKE3
	select BR2_PACKAGE_XXHASH
	select BR2_PACKAGE_ZSTD
	help
	  Compiler cache, built for the target.

	  https://ccache.dev/
