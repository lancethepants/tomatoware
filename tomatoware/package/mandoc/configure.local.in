# Answers for mandoc's configure, for a musl target. See mandoc.mk.

PREFIX="@PREFIX@"
MANDIR="@PREFIX@/share/man"
MANPATH_BASE="@PREFIX@/share/man:@PREFIX@/man"
MANPATH_DEFAULT="@PREFIX@/share/man:@PREFIX@/man"

CC="@CC@"
AR="@AR@"
CFLAGS="@CFLAGS@ -D_GNU_SOURCE -std=gnu17 -fcommon"
LDFLAGS="@LDFLAGS@"
LDADD="@LDADD@"
# A single space: non-empty, so configure doesn't try -static.
STATIC=" "

OSENUM=MANDOC_OS_OTHER
UTF8_LOCALE="C.UTF-8"
BINM_PAGER=less

HAVE_ATTRIBUTE=1
HAVE_CMSG=1
HAVE_DIRENT_NAMLEN=0
HAVE_EFTYPE=0
HAVE_ENDIAN=1
HAVE_ERR=1
HAVE_FTS=1
HAVE_FTS_COMPARE_CONST=0
HAVE_GETLINE=1
HAVE_GETSUBOPT=1
HAVE_ISBLANK=1
HAVE_LESS_T=1
HAVE_MKDTEMP=1
HAVE_MKSTEMPS=1
HAVE_NANOSLEEP=1
HAVE_NTOHL=1
HAVE_O_DIRECTORY=1
HAVE_OHASH=0
HAVE_PATH_MAX=1
HAVE_PLEDGE=0
HAVE_PROGNAME=0
HAVE_REALLOCARRAY=1
HAVE_RECALLOCARRAY=0
HAVE_RECVMSG=1
HAVE_REWB_BSD=0
HAVE_REWB_SYSV=1
HAVE_SANDBOX_INIT=0
HAVE_STRCASESTR=1
HAVE_STRINGLIST=0
HAVE_STRLCAT=1
HAVE_STRLCPY=1
HAVE_STRNDUP=1
HAVE_STRPTIME=1
HAVE_STRSEP=1
HAVE_STRTONUM=0
HAVE_SYS_ENDIAN=0
HAVE_VASPRINTF=1
HAVE_WCHAR=1
